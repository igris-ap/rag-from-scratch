# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Project-generated folders (large, reconstructable by running the app).
# Exception: the rag_system_reference fixture is committed on purpose —
# eval_questions.json is written against it, so eval.py must be
# reproducible on a fresh clone. Uses `dir/*` (not `dir/`) because git
# cannot re-include a file whose parent directory is itself excluded.
markdown/*
!markdown/rag_system_reference.md
parent_store/*
!parent_store/rag_system_reference_*.json

# Eval output — regenerated on every `python3 eval.py` run
eval_results.json

# Local agent guidance — not part of the project
CLAUDE.md

# PDFs (likely private/copyrighted — user adds their own).
# Exception: the reference fixture backing eval_questions.json.
docs/*
!docs/rag_system_reference.pdf

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Environment
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Gradio temp files
gradio_cached_examples/
flagged/
